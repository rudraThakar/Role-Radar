{
  "name": "@roleradar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --watch --enable-source-maps dist/main.js",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "check:watches": "node --env-file-if-exists=.env dist/check-watches.js",
    "seed": "node --env-file-if-exists=.env dist/seed.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "node --test dist/app.e2e.test.js dist/**/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@roleradar/domain": "*",
    "argon2": "^0.45.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "^5.22.0"
  }
}
